<HomeScreen>:
    canvas.before:
        Color:
            rgba: (0.95, 0.97, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "14dp"

        ScreenTitle:
            text: "ClassBase"

        MutedLabel:
            text: "Gerenciamento de alunos"
            size_hint_y: None
            height: "30dp"

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "128dp"
            padding: "18dp"
            spacing: "4dp"
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [16]

            MutedLabel:
                text: "Alunos cadastrados"
                size_hint_y: None
                height: "28dp"

            Label:
                id: student_count
                text: "0"
                color: (0.10, 0.38, 0.86, 1)
                font_size: "38sp"
                bold: True
                halign: "left"
                valign: "middle"
                text_size: self.size

        Widget:

        PrimaryButton:
            text: "Cadastrar aluno"
            on_release: root.manager.current = "cadastro"

        SecondaryButton:
            text: "Consultar alunos"
            on_release: root.manager.current = "alunos"

        SecondaryButton:
            text: "Sair"
            on_release: root.logout()
