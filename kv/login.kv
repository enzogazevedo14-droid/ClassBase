<LoginScreen>:
    canvas.before:
        Color:
            rgba: (0.95, 0.97, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"

        BoxLayout:
            orientation: "vertical"
            size_hint: (0.88, None)
            height: "410dp"
            padding: "24dp"
            spacing: "14dp"

            ScreenTitle:
                text: "ClassBase"
                halign: "center"

            MutedLabel:
                text: "Gerenciamento de alunos"
                halign: "center"
                size_hint_y: None
                height: "30dp"

            AppTextInput:
                id: username_input
                hint_text: "Usuário"

            AppTextInput:
                id: password_input
                hint_text: "Senha"
                password: True
                on_text_validate: root.login()

            FeedbackLabel:
                id: feedback
                text: ""

            PrimaryButton:
                text: "Entrar"
                on_release: root.login()

            MutedLabel:
                text: "Acesso local e offline"
                halign: "center"
                size_hint_y: None
                height: "28dp"
