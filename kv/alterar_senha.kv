<ChangeDemoPasswordScreen>:
    canvas.before:
        Color:
            rgba: (0.95, 0.97, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        bar_width: "6dp"
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: "24dp"
            spacing: "12dp"

            ScreenTitle:
                text: "Atualizar senha"

            MutedLabel:
                text: "A senha de demonstração precisa ser substituída antes de acessar os alunos."
                size_hint_y: None
                height: "60dp"

            AppTextInput:
                id: current_password
                hint_text: "Senha atual"
                password: True

            AppTextInput:
                id: new_password
                hint_text: "Nova senha (12 caracteres ou mais)"
                password: True

            AppTextInput:
                id: confirm_password
                hint_text: "Confirmar nova senha"
                password: True
                on_text_validate: root.update_password()

            FeedbackLabel:
                id: change_feedback
                text: ""

            PrimaryButton:
                text: "Atualizar senha"
                on_release: root.update_password()

            SecondaryButton:
                text: "Voltar ao login"
                on_release: root.back_to_login()
