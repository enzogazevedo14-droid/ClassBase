<StudentListScreen>:
    canvas.before:
        Color:
            rgba: (0.95, 0.97, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp"
        spacing: "12dp"

        ScreenTitle:
            text: "Alunos"

        AppTextInput:
            id: search_input
            hint_text: "Pesquisar por RM, nome ou curso"
            on_text: root.refresh_students(self.text)

        ScrollView:
            do_scroll_x: False
            bar_width: "6dp"

            BoxLayout:
                id: student_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "10dp"

        SecondaryButton:
            text: "Voltar"
            on_release: root.manager.current = "home"
