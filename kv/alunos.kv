<StudentListScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 24
        spacing: 12

        Label:
            text: "Alunos"
            font_size: "24sp"
            size_hint_y: None
            height: "52dp"

        TextInput:
            id: search_input
            hint_text: "Pesquisar por RM, nome ou curso"
            multiline: False
            size_hint_y: None
            height: "48dp"
            on_text: root.refresh_students(self.text)

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                id: student_list
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: 8

        Button:
            text: "Voltar"
            size_hint_y: None
            height: "48dp"
            on_release: root.manager.current = "home"
