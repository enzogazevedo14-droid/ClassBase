#:import COURSES screens.cadastro.COURSES

<EditStudentScreen>:
    canvas.before:
        Color:
            rgba: (0.95, 0.97, 1, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "12dp"

        ScreenTitle:
            text: "Editar aluno"

        MutedLabel:
            text: "Atualize os dados do cadastro."
            size_hint_y: None
            height: "30dp"

        AppTextInput:
            id: rm_input
            hint_text: "RM"

        AppTextInput:
            id: name_input
            hint_text: "Nome completo"

        Spinner:
            id: course_input
            text: "Selecione o curso"
            values: COURSES
            size_hint_y: None
            height: "52dp"
            background_normal: ""
            background_color: (0.96, 0.97, 0.99, 1)
            color: (0.10, 0.14, 0.20, 1)
            font_size: "16sp"

        FeedbackLabel:
            id: feedback
            text: ""

        PrimaryButton:
            text: "Salvar alterações"
            on_release: root.save_student()

        SecondaryButton:
            text: "Cancelar"
            on_release: root.manager.current = "alunos"
